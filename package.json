    "@react-router/serve": "^7.9.2",
    "buffer": "^6.0.3",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "isbot": "^5.1.31",
    "isomorphic-git": "^1.42.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.2",
    "serve": "^14.2.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.57.0",
